# Optional settings. Copy to .env (Docker Compose reads it automatically) and change what you need,
# or let `python scripts/ports.py` write the ports for you when one is already taken.

# Host ports (what you open in the browser). Change one if another program already uses it.
SHOP_PORT=8000            # Lakeshop store and /admin.html
DASHBOARD_PORT=8501       # Streamlit dashboard
FLINK_PORT=8081           # Flink UI
REGISTRY_PORT=8085        # Schema Registry API
KAFKA_UI_PORT=8088        # Kafka UI
TRINO_PORT=8090           # Trino (SQL, and its web UI)
ICEBERG_REST_PORT=8181    # Iceberg REST catalog
S3_PORT=9000              # RustFS S3 API
S3_CONSOLE_PORT=9001      # RustFS console (admin / password)
KAFKA_PORT=29092          # Kafka listener for tools on this machine

# Simulated traffic (docker compose --profile simulator up -d)
SESSIONS_PER_SEC=20

# Table maintenance
MAINTENANCE_INTERVAL_MINUTES=10
SNAPSHOT_RETENTION=1h     # time-travel window; at least 10m
